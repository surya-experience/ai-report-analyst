# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never exposed to the client. Used for admin operations that
# must bypass RLS (e.g. seeding, background jobs). Keep this out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for the AI Coach, campaign copy generation, and Report Analyst
ANTHROPIC_API_KEY=your-anthropic-api-key

# Base URL of the deployed app (used for auth redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — email delivery for campaigns. Without this set, sends are
# logged instead of delivered, so the campaign flow still works end to end.
RESEND_API_KEY=
EMAIL_FROM="Experience.com <notifications@experience.com>"

# Stripe — Pro subscription checkout. Without these set, the Upgrade button
# shows a clear "billing not configured" error instead of failing silently.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From `stripe listen --print-secret` locally, or the webhook endpoint's
# signing secret in the Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=
